	<parameter name="ResultadoFiltro" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT 
    j.nombre_jugador,
    c.nombre_campeon,
    p.Fecha_jugada,
    p.KDA,
    p.Resultado,
    c.rol_mapa,
    j.nacionalidad
FROM juegan p
JOIN jugadores j ON p.ID_Jugador = j.idJugadores
JOIN campeones c ON p.ID_Campeon = c.idCampeones
WHERE $P{ResultadoFiltro} = '' OR p.Resultado = $P{ResultadoFiltro}
ORDER BY p.Fecha_jugada DESC]]></query>
