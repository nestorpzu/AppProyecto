<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="campeones.EditarControllerCampeon" stylesheets="@estilos/estiloCampeon.css">

    <children>
        <VBox spacing="10" alignment="CENTER">
            <!-- Título -->
            <Label text="Editar Campeón" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

            <!-- Nombre del Campeón -->
            <VBox spacing="5">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Nombre del Campeón" />
                </HBox>
                <TextField fx:id="txtNombre" promptText="Ej. Ahri" />
            </VBox>

            <!-- Descripción -->
            <VBox spacing="5">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Descripción" />
                </HBox>
                <TextArea fx:id="txtDescripcion" promptText="Descripción del campeón" prefRowCount="2" />
            </VBox>

            <!-- Rol -->
            <VBox spacing="5">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Rol" />
                </HBox>
                <TextField fx:id="txtRol" promptText="Ej. Mago" />
            </VBox>

            <!-- Dificultad -->
            <VBox spacing="5">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Dificultad" />
                </HBox>
                <ComboBox fx:id="comboDificultad" promptText="Selecciona dificultad" />
            </VBox>

            <!-- Botones -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="Guardar Cambios" fx:id="btnEditar" onAction="#editarCampeon" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                <Button text="Cancelar" fx:id="btnCancelar" onAction="#cancelar" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
            </HBox>
        </VBox>
    </children>
    <padding>
        <Insets top="15" right="15" bottom="15" left="15" />
    </padding>
</StackPane>
