<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<TabPane prefHeight="550.0" prefWidth="668.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
   <tabs>
        <!-- Tab: Jugadores -->
        <Tab closable="false" text="Jugadores">      
            <AnchorPane>  
                <children>
                    <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
                        <!-- Botones superiores -->
                        <!-- HBox con el Label y el Botón alineados a la izquierda y derecha respectivamente -->
                        <HBox spacing="10">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Lista de Jugadores" />
                            <Region fx:id="spacer" HBox.hgrow="ALWAYS" />
                     <MenuButton alignment="TOP_LEFT" mnemonicParsing="false" nodeOrientation="LEFT_TO_RIGHT" text="Importar/Exportar ">
                       <items>
                            <MenuItem mnemonicParsing="false" text="Importar CSV" onAction="#importarCSVJugadores" />
                            <MenuItem mnemonicParsing="false" text="Importar JSON" onAction="#importarJSONJugadores" />
                            <MenuItem mnemonicParsing="false" text="Exportar CSV" onAction="#exportarCSVJugadores" />
                            <MenuItem mnemonicParsing="false" text="Exportar JSON" onAction="#exportarJSONJugadores" />
                       </items>
                        <contextMenu>
                           <ContextMenu>
                             <items>
                               <MenuItem mnemonicParsing="false" text="Unspecified Action" />
                             </items>
                           </ContextMenu>
                        </contextMenu>
                     </MenuButton> <!-- Espaciador que empuja el botón hacia la derecha -->
                            <Button fx:id="btnAnadir" onAction="#abrirBtnAnadir" text="Añadir Jugador" />                                
                        </HBox>

                        <!-- HBox con los botones de filtros y campo de búsqueda -->
                        <HBox spacing="10">
                            <Button fx:id="btnListaFiltros" onAction="#abrirListaDeFiltros1" text="Lista de filtros" />
                                
                        <Button fx:id="btnBorrar" onAction="#borrarFiltros1" text="Borrar filtros" />
                             
                            <Region fx:id="spacer2" HBox.hgrow="ALWAYS" /> <!-- Espaciador para empujar el botón hacia la derecha -->
                            <TextField fx:id="txtBuscarJugador" promptText="Buscar jugador..." />
                        </HBox>
                        
                        <!-- Tabla de jugadores -->
                        <TableView fx:id="tablaJugadores">
                            <columns>                          
                               <TableColumn fx:id="colNombreJugador" text="NOMBRE" />
                                <TableColumn fx:id="colDescripcionJugador" text="DESCRIPCIÓN" />
                                <TableColumn fx:id="colEdadJugador" text="EDAD" />
                                <TableColumn fx:id="colEmailJugador" text="EMAIL" />
                                <TableColumn fx:id="colNacionalidadJugador" text="NACIONALIDAD" />
                                <TableColumn fx:id="colPosicionJugador" text="POSICION" />
                                <TableColumn fx:id="columnaAccionesJugadores" text="ACCIONES">
                                    <!-- Columna para acciones como editar o borrar -->
                                </TableColumn>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </children>
            </AnchorPane>
        </Tab>

        <!-- Tab: Campeones -->
        <Tab closable="close" text="Campeones">
            <AnchorPane>
                <children>
                    <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
                        <!-- Botones superiores -->
                         <!-- HBox con el Label y el Botón alineados a la izquierda y derecha respectivamente -->
                        <HBox spacing="10">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Lista de Campeones" />
                            <Region fx:id="spacer3" HBox.hgrow="ALWAYS" />
                     <MenuButton alignment="TOP_CENTER" contentDisplay="CENTER" mnemonicParsing="false" nodeOrientation="LEFT_TO_RIGHT" text="Importar/Exportar " textAlignment="CENTER">
                       <items>
                            <MenuItem mnemonicParsing="false" text="Importar CSV" onAction="#importarCSVCampeones" />
                            <MenuItem mnemonicParsing="false" text="Importar JSON" onAction="#importarJSONCampeones" />
                            <MenuItem mnemonicParsing="false" text="Exportar CSV" onAction="#exportarCSVCampeones" />
                            <MenuItem mnemonicParsing="false" text="Exportar JSON" onAction="#exportarJSONCampeones" />
                       </items>
                     </MenuButton> <!-- Espaciador que empuja el botón hacia la derecha -->
                            <Button fx:id="btnAnadir2" onAction="#abrirBtnAnadirCampeon" text="Añadir Campeon" />                               
                        </HBox>
                         
                        <HBox spacing="10">
                            <Button fx:id="btnListaFiltro2" onAction="#abrirListaDeFiltros2" text="Lista de filtros" />                                 
                            <Button fx:id="btnBorrar2" onAction="#borrarFiltros2" text="Borrar filtros" />                               
                            <Region fx:id="spacer4" HBox.hgrow="ALWAYS" /> <!-- Espaciador para empujar el botón hacia la derecha -->
                            <TextField fx:id="txtBuscarCampeon" promptText="Buscar campeón..." />
                        </HBox>

                        <!-- Tabla de jugadores -->
                        <TableView fx:id="tablaCampeones">
                            <columns>
                                <TableColumn fx:id="colNombreCampeon" text="NOMBRE" />
                                <TableColumn fx:id="colDescripcionCampeon" text="DESCRIPCIÓN" />
                                <TableColumn fx:id="colImagenCampeon" prefWidth="75.0" text="IMAGEN" />
                                <TableColumn fx:id="colRolCampeon" text="ROL" />
                                <TableColumn fx:id="colDificultadCampeon" text="DIFICULTAD" />
                                <TableColumn fx:id="columnaAccionesCampeones" text="ACCIONES" />
                            </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>

                        </TableView>

                        
                    </VBox>
                </children>
            </AnchorPane>
        </Tab>

        <!-- Tab: Partidas -->
        <Tab closable="close" text="Partidas">
            <AnchorPane>
                <children>
                    <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
                        <!-- Botones superiores -->
                        <HBox spacing="10">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Lista de Partidas" />
                            <Region fx:id="spacer6" HBox.hgrow="ALWAYS" />
                     <MenuButton mnemonicParsing="false" nodeOrientation="LEFT_TO_RIGHT" text="Importar/Exportar ">
                       <items>
                            <MenuItem mnemonicParsing="false" text="Importar CSV" onAction="#importarCSVPartidas" />
                            <MenuItem mnemonicParsing="false" text="Importar JSON" onAction="#importarJSONPartidas" />
                            <MenuItem mnemonicParsing="false" text="Exportar CSV" onAction="#exportarCSVPartidas" />
                            <MenuItem mnemonicParsing="false" text="Exportar JSON" onAction="#exportarJSONPartidas" />
                       </items>
                     </MenuButton> <!-- Espaciador que empuja el botón hacia la derecha -->
                            <Button fx:id="btnAnadir3" onAction="#abrirBtnAnadirPartida" text="Añadir Partida" />                              
                        </HBox>
                        <HBox spacing="10">
                             <Button fx:id="btnListaFiltros3" onAction="#abrirListaDeFiltros3" text="Lista de filtros" />                                  
                            <Button fx:id="btnBorrar3" onAction="#borrarFiltros3" text="Borrar filtros" />                              
                            <Region fx:id="spacer5" HBox.hgrow="ALWAYS" /> <!-- Espaciador para empujar el botón hacia la derecha -->
                            <TextField fx:id="txtBuscarPartida" promptText="Buscar partidas..." />
                        </HBox>

                        <!-- Tabla de jugadores -->
                        <TableView fx:id="tablaPartidas">
                            <columns>                                 
                                <TableColumn fx:id="colJugadorPartida" text="JUGADORES" />
                                <TableColumn fx:id="colCampeonesPartida" text="CAMPEONES" />
                                <TableColumn fx:id="colFechaPartida" text="FECHA" />
                                <TableColumn fx:id="colKDA" text="KDA" />
                                <TableColumn fx:id="colResultadoPartida" text="RESULTADO" />                                
                                <TableColumn fx:id="columnaAccionesPartida" text="ACCIONES" />
                            </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                        </TableView>

                        
                    </VBox>
                </children>
            </AnchorPane>
        </Tab>
    </tabs>
</TabPane>
