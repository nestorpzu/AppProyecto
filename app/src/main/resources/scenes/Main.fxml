<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Tooltip?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
    <TabPane prefHeight="600" prefWidth="680">
   <tabs>
        <!-- Tab: Jugadores -->
        <Tab closable="false">  
            <graphic>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <ImageView fitHeight="23" fitWidth="23" focusTraversable="true" pickOnBounds="true" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../icons/usuarios.png" />
                        </image>
                    </ImageView>
                    <Label style="-fx-font-weight: 800; -fx-text-fill: #0F172A;" text="Jugadores" />
                </HBox>
            </graphic>
        <content>    
            <AnchorPane>  
                <children>
                    <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
                        <!-- Botones superiores -->
                        <!-- HBox con el Label y el Botón alineados a la izquierda y derecha respectivamente -->
                        <HBox spacing="10">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Lista de Jugadores" />
                            <Region fx:id="spacer" HBox.hgrow="ALWAYS" />
                     <MenuButton alignment="TOP_LEFT" mnemonicParsing="false" nodeOrientation="LEFT_TO_RIGHT" text="Importar/Exportar ">
                       <items>
                            <MenuItem mnemonicParsing="false" onAction="#importarCSVJugadores" text="Importar CSV" />
                            <MenuItem mnemonicParsing="false" onAction="#importarJSONJugadores" text="Importar JSON" />
                            <MenuItem mnemonicParsing="false" onAction="#exportarCSVJugadores" text="Exportar CSV" />
                            <MenuItem mnemonicParsing="false" onAction="#exportarJSONJugadores" text="Exportar JSON" />
                       </items>
                     </MenuButton> <!-- Espaciador que empuja el botón hacia la derecha -->
                            <Button fx:id="btnAnadir" onAction="#abrirBtnAnadir" text="Añadir Jugador">
                                <graphic>
                                    <ImageView fitHeight="15" fitWidth="15" pickOnBounds="true" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../icons/anadir.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>                               
                        </HBox>

                        <!-- HBox con los botones de filtros y campo de búsqueda -->
                        <HBox spacing="10">
                            <Button fx:id="btnListaFiltros" onAction="#abrirListaDeFiltros1" text="Lista de filtros">
                                <graphic>
                                    <ImageView fitHeight="15" fitWidth="15" pickOnBounds="true" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../icons/filtrar.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>      
                            <Button fx:id="btnBorrar" onAction="#borrarFiltros1" text="Borrar filtros" >
                                <graphic>
                                    <ImageView fitHeight="15" fitWidth="15" pickOnBounds="true" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../icons/basura.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>    
                            <Region fx:id="spacer2" HBox.hgrow="ALWAYS" /> <!-- Espaciador para empujar el botón hacia la derecha -->
                            <!-- lupa al lado de Buscar Jugador-->
                            <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #D7DCE7; -fx-border-radius: 8; -fx-padding: 0 12 0 12;">
                                <children>
                                    <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../icons/lupa.png" />
                                        </image>
                                    </ImageView>
                                    <TextField fx:id="txtBuscarJugador" promptText="Buscar jugador..." style="-fx-border-color: transparent; -fx-background-color: transparent;" HBox.hgrow="ALWAYS" />
                                </children>
                            </HBox>
                        </HBox>
                        
                        <!-- Tabla de jugadores -->
                        <TableView fx:id="tablaJugadores">
                            <columns>                          
                               <TableColumn fx:id="colNombreJugador" text="NOMBRE" />
                                <TableColumn fx:id="colDescripcionJugador" text="DESCRIPCIÓN" />
                                <TableColumn fx:id="colEdadJugador" text="EDAD" />
                                <TableColumn fx:id="colEmailJugador" text="EMAIL" />
                                <TableColumn fx:id="colNacionalidadJugador" text="NACIONALIDAD" />
                                <TableColumn fx:id="colPosicionJugador" text="POSICION" />
                                <TableColumn fx:id="columnaAccionesJugadores" text="ACCIONES">
                                    <!-- Columna para acciones como editar o borrar -->
                                </TableColumn>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </children>
            </AnchorPane>
                </content>

        </Tab>

        <!-- Tab: Campeones -->
        <Tab closable="false">  
            <graphic>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <ImageView fitHeight="20" fitWidth="20" focusTraversable="true" pickOnBounds="true" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../icons/trofeo.png" />
                        </image>
                    </ImageView>
                    <Label style="-fx-font-weight: 800; -fx-text-fill: #0F172A;" text="Campeones" />
                </HBox>
            </graphic>
            <content> 
            <AnchorPane>
                <children>
                    <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
                        <!-- Botones superiores -->
                         <!-- HBox con el Label y el Botón alineados a la izquierda y derecha respectivamente -->
                        <HBox spacing="10">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Lista de Campeones" />
                            <Region fx:id="spacer3" HBox.hgrow="ALWAYS" />     
                            <Button fx:id="btnInformeCampeones" onAction="#abrirInformeCampeones" text="Informes" />
                     <MenuButton alignment="TOP_CENTER" contentDisplay="CENTER" mnemonicParsing="false" nodeOrientation="LEFT_TO_RIGHT" text="Importar/Exportar " textAlignment="CENTER">
                       <items>
                            <MenuItem mnemonicParsing="false" onAction="#importarCSVCampeones" text="Importar CSV" />
                            <MenuItem mnemonicParsing="false" onAction="#importarJSONCampeones" text="Importar JSON" />
                            <MenuItem mnemonicParsing="false" onAction="#exportarCSVCampeones" text="Exportar CSV" />
                            <MenuItem mnemonicParsing="false" onAction="#exportarJSONCampeones" text="Exportar JSON" />
                       </items>
                     </MenuButton> <!-- Espaciador que empuja el botón hacia la derecha -->
                            <Button fx:id="btnAnadir2" onAction="#abrirBtnAnadirCampeon" text="Añadir Campeon">
                                <graphic>
                                    <ImageView fitHeight="15" fitWidth="15" pickOnBounds="true" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../icons/anadir.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>                          
                        </HBox>
                         
                        <HBox spacing="10">
                            <Button fx:id="btnListaFiltro2" onAction="#abrirListaDeFiltros2" text="Lista de filtros">
                                <graphic>
                                    <ImageView fitHeight="15" fitWidth="15" pickOnBounds="true" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../icons/filtrar.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>                                 
                            <Button fx:id="btnBorrar2" onAction="#borrarFiltros2" text="Borrar filtros" >
                                <graphic>
                                    <ImageView fitHeight="15" fitWidth="15" pickOnBounds="true" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../icons/basura.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>                                   
                            <Region fx:id="spacer4" HBox.hgrow="ALWAYS" /> <!-- Espaciador para empujar el botón hacia la derecha -->
                            <!-- lupa al lado de Buscar Campeon-->
                            <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #D7DCE7; -fx-border-radius: 8; -fx-padding: 0 12 0 12;">
                                <children>
                                    <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../icons/lupa.png" />
                                        </image>
                                    </ImageView>
                                    <TextField fx:id="txtBuscarCampeon" promptText="Buscar campeon..." style="-fx-border-color: transparent; -fx-background-color: transparent;" HBox.hgrow="ALWAYS" />
                                </children>
                            </HBox>
                        </HBox>

                        <!-- Tabla de jugadores -->
                        <TableView fx:id="tablaCampeones">
                            <columns>
                                <TableColumn fx:id="colNombreCampeon" text="NOMBRE" />
                                <TableColumn fx:id="colDescripcionCampeon" text="DESCRIPCIÓN" />
                                <TableColumn fx:id="colImagenCampeon" prefWidth="75.0" text="IMAGEN" />
                                <TableColumn fx:id="colRolCampeon" text="ROL" />
                                <TableColumn fx:id="colDificultadCampeon" text="DIFICULTAD" />
                                <TableColumn fx:id="columnaAccionesCampeones" text="ACCIONES" />
                            </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>

                        </TableView>

                        
                    </VBox>
                </children>
            </AnchorPane>
             </content> 
        </Tab>

        <!-- Tab: Partidas -->
        <Tab closable="false">  
        <graphic>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <ImageView fitHeight="20" fitWidth="20" focusTraversable="true" pickOnBounds="true" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../icons/calendario.png" />
                        </image>
                    </ImageView>
                    <Label style="-fx-font-weight: 800; -fx-text-fill: #0F172A;" text="Partidas" />
                </HBox>
            </graphic>
            <content>
            <AnchorPane>
                <children>
                    <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
                        <!-- Botones superiores -->
                        <HBox spacing="10">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Lista de Partidas" />
                            <Region fx:id="spacer6" HBox.hgrow="ALWAYS" />
                     <Button fx:id="btnInformePartidas" onAction="#abrirInformePartidas" text="Informes" />
                     <MenuButton mnemonicParsing="false" nodeOrientation="LEFT_TO_RIGHT" text="Importar/Exportar ">
                       <items>
                            <MenuItem mnemonicParsing="false" onAction="#importarCSVPartidas" text="Importar CSV" />
                            <MenuItem mnemonicParsing="false" onAction="#importarJSONPartidas" text="Importar JSON" />
                            <MenuItem mnemonicParsing="false" onAction="#exportarCSVPartidas" text="Exportar CSV" />
                            <MenuItem mnemonicParsing="false" onAction="#exportarJSONPartidas" text="Exportar JSON" />
                       </items>
                     </MenuButton> <!-- Espaciador que empuja el botón hacia la derecha -->
                            <Button fx:id="btnAnadir3" onAction="#abrirBtnAnadirPartida" text="Añadir Partida">
                                <graphic>
                                    <ImageView fitHeight="15" fitWidth="15" pickOnBounds="true" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../icons/anadir.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>                             
                        </HBox>
                        <HBox spacing="10">
                             <Button fx:id="btnListaFiltros3" onAction="#abrirListaDeFiltros3" text="Lista de filtros">
                                <graphic>
                                    <ImageView fitHeight="15" fitWidth="15" pickOnBounds="true" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../icons/filtrar.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>                                  
                            <Button fx:id="btnBorrar3" onAction="#borrarFiltros3" text="Borrar filtros" >
                                <graphic>
                                    <ImageView fitHeight="15" fitWidth="15" pickOnBounds="true" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../icons/basura.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>                                 
                            <Region fx:id="spacer5" HBox.hgrow="ALWAYS" /> <!-- Espaciador para empujar el botón hacia la derecha -->
                            <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #D7DCE7; -fx-border-radius: 8; -fx-padding: 0 12 0 12;">
                                <children>
                                    <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../icons/lupa.png" />
                                        </image>
                                    </ImageView>
                                    <TextField fx:id="txtBuscarPartida" promptText="Buscar partida..." style="-fx-border-color: transparent; -fx-background-color: transparent;" HBox.hgrow="ALWAYS" />
                                </children>
                            </HBox>
                        </HBox>

                        <!-- Tabla de jugadores -->
                        <TableView fx:id="tablaPartidas">
                            <columns>                                 
                                <TableColumn fx:id="colJugadorPartida" text="JUGADORES" />
                                <TableColumn fx:id="colCampeonesPartida" text="CAMPEONES" />
                                <TableColumn fx:id="colFechaPartida" text="FECHA" />
                                <TableColumn fx:id="colKDA" text="KDA" />
                                <TableColumn fx:id="colResultadoPartida" text="RESULTADO" />                                
                                <TableColumn fx:id="columnaAccionesPartida" text="ACCIONES" />
                            </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                        </TableView>

                        
                    </VBox>
                </children>
            </AnchorPane>
            </content>
        </Tab>
    </tabs>
   <padding>
      <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
   </padding>
</TabPane>
<Button fx:id="btnAyuda" onAction="#abrirAyuda" style="-fx-background-color: transparent; -fx-cursor: hand;" StackPane.alignment="TOP_RIGHT">
    <StackPane.margin>
        <Insets bottom="0" left="0" right="20" top="10" />
    </StackPane.margin>
        <graphic>
            <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../icons/pregunta.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>
</StackPane>
