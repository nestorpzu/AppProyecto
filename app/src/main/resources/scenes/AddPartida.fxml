<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="partidas.AddControllerPartida">

    <children>
        <VBox spacing="10" alignment="CENTER">
            <!-- Título -->
            <Label text="Añadir Partida" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

            <!-- Jugador -->
            <VBox spacing="5">
                <CheckBox fx:id="checkJugador" text="Jugador:" />
                <TextField fx:id="txtJugador" promptText="Ej. Juan" />
            </VBox>

            <!-- Campeón -->
            <VBox spacing="5">
                <CheckBox fx:id="checkCampeon" text="Campeón:" />
                <TextField fx:id="txtCampeon" promptText="Ej. Darius" />
            </VBox>

            <!-- Fecha -->
            <VBox spacing="5">
                <CheckBox fx:id="checkFecha" text="Fecha:" />
                <DatePicker fx:id="dateFecha" promptText="dd/mm/aa" />
            </VBox>

            <!-- KDA -->
            <VBox spacing="5">
                <CheckBox fx:id="checkKDA" text="KDA:" />
                <TextField fx:id="txtKDA" promptText="Ej: 10/3/5"/>

            </VBox>

            <!-- Resultado -->
            <VBox spacing="5">
                <CheckBox fx:id="checkResultado" text="Resultado:" />
                <ComboBox fx:id="comboResultado" promptText="Selecciona un resultado" />
            </VBox>

            <!-- Botones -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="Añadir Partida" fx:id="btnAnadir" onAction="#anadirPartida" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                <Button text="Cancelar" fx:id="btnCancelar" onAction="#cancelar" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
            </HBox>
        </VBox>
    </children>

    <!-- Padding para espaciar el contenido -->
    <padding>
        <Insets top="15" right="15" bottom="15" left="15" />
    </padding>
</StackPane>
