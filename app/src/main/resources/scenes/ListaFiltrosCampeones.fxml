<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="campeones.ListaControllerCampeones">
    <children>
        <VBox spacing="10" alignment="CENTER">
            <!-- Título -->
            <Label text="Filtrar Campeones" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

            <!-- Nombre del Campeón -->
            <VBox spacing="5">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="chkNombre" text="Nombre del Campeón" />
                </HBox>
                <TextField fx:id="txtNombreCampeon" promptText="Ej. Ahri" />
            </VBox>

            <!-- Descripción -->
            <VBox spacing="5">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="chkDescripcion" text="Descripción" />
                </HBox>
                <TextArea fx:id="txtDescripcion" promptText="Ej. Mago con gran movilidad" prefRowCount="2" />
            </VBox>

            <!-- Rol -->
            <VBox spacing="5">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="chkRol" text="Rol" />
                </HBox>
                <ComboBox fx:id="cmbRol" promptText="Selecciona un Rol" />
            </VBox>

            <!-- Dificultad -->
            <VBox spacing="5">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="chkDificultad" text="Dificultad" />
                </HBox>
                <ComboBox fx:id="cmbDificultad" promptText="Selecciona una Dificultad" />
            </VBox>

            <!-- Botones -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="Aplicar Filtros" fx:id="btnAplicarFiltros" onAction="#aplicarFiltros"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                <Button text="Cancelar" fx:id="btnCancelar" onAction="#cancelar"
                        style="-fx-background-color: #f44336; -fx-text-fill: white;" />
            </HBox>
        </VBox>
    </children>
    <padding>
        <Insets top="15" right="15" bottom="15" left="15" />
    </padding>
</StackPane>
